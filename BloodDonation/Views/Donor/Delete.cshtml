@model BloodDonation.EF.Tables.Donor

@{
    ViewBag.Title = "Delete Donor";
}

<div class="container mt-5">

    <div class="card border-danger shadow">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Delete Donor</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">

                <strong>Warning!</strong>

                This action will permanently remove the donor from the system.

                Are you sure you want to continue?

            </div>

            <table class="table table-bordered table-hover">

                <tr>
                    <th width="30%">Donor ID</th>
                    <td>@Model.DonorId</td>
                </tr>

                <tr>
                    <th>Full Name</th>
                    <td>@Model.FullName</td>
                </tr>

                <tr>
                    <th>Blood Group</th>
                    <td>
                        <span class="badge bg-danger">
                            @Model.BloodGroup
                        </span>
                    </td>
                </tr>

                <tr>
                    <th>Contact Number</th>
                    <td>@Model.ContactNo</td>
                </tr>

                <tr>
                    <th>City</th>
                    <td>@Model.City</td>
                </tr>

                <tr>
                    <th>Last Donation Date</th>
                    <td>@Model.LastDonationDate.ToString("dd MMM yyyy")</td>
                </tr>

            </table>

            <form method="post">

                <input type="hidden"
                       name="DonorId"
                       value="@Model.DonorId" />

                <button type="submit" class="btn btn-danger">
                    Delete Donor
                </button>

                <a href="/Donor/Read" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>