@model BloodDonation.Models.DonorListVM

@{
    ViewBag.Title = "Donor Management";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="text-danger">
            Donor Management
        </h2>

        <a href="/Donor/Create" class="btn btn-success">
            + Register New Donor
        </a>

    </div>

    <div class="card shadow">

        <div class="card-body">

            <form method="get" class="row g-3 mb-4">

                <div class="col-md-4">

                    <label class="form-label fw-bold">Donor Name</label>

                    <input type="text"
                           name="name"
                           class="form-control"
                           placeholder="Search by name"
                           value="@Model.Name" />

                </div>

                <div class="col-md-3">

                    <label class="form-label fw-bold">Blood Group</label>

                    <select name="bloodGroup" class="form-select">

                        <option value="">-- All --</option>

                        @foreach (var group in BloodGroups.All)
                        {
                            <option value="@group" selected="@(Model.BloodGroup == group)">
                                @group
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-3">

                    <label class="form-label fw-bold">City</label>

                    <select name="city" class="form-select">

                        <option value="">-- All --</option>

                        @foreach (var city in Model.Cities)
                        {
                            <option value="@city" selected="@(Model.City == city)">
                                @city
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-2 d-flex align-items-end gap-2">

                    <button type="submit" class="btn btn-danger w-100">
                        Search
                    </button>

                    <a href="/Donor/Read" class="btn btn-secondary w-100">
                        Reset
                    </a>

                </div>

            </form>

            <table class="table table-bordered table-hover table-striped align-middle">

                <thead class="table-danger">

                    <tr>
                        <th>Donor ID</th>
                        <th>Full Name</th>
                        <th>Blood Group</th>
                        <th>Contact Number</th>
                        <th>City</th>
                        <th>Last Donation Date</th>
                        <th class="text-center">Action</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Donors.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">
                                No donors found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var donor in Model.Donors)
                        {
                            <tr>

                                <td>@donor.DonorId</td>

                                <td>@donor.FullName</td>

                                <td>
                                    <span class="badge bg-danger">
                                        @donor.BloodGroup.Trim()
                                    </span>
                                </td>

                                <td>@donor.ContactNo</td>

                                <td>@donor.City</td>

                                <td>
                                    @donor.LastDonationDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="text-center">

                                    <a href="/Donor/Edit/@donor.DonorId"
                                       class="btn btn-primary btn-sm">
                                        Edit
                                    </a>

                                    <a href="/Donor/Delete/@donor.DonorId"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

            <partial name="_Pagination" model="Model.Pager" />

        </div>

    </div>

</div>