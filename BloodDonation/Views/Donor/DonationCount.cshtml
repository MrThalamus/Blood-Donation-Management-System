@model List<BloodDonation.Models.DonorDonationCountVM>

@{
    ViewBag.Title = "Donor Donation Count";
}

<h2>@ViewBag.Title</h2>

<table border="1" cellpadding="8" cellspacing="0">
    <thead>
        <tr>
            <th>Donor ID</th>
            <th>Full Name</th>
            <th>Total Donations</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var donor in Model)
        {
            <tr>
                <td>@donor.DonorId</td>
                <td>@donor.FullName</td>
                <td>@donor.TotalDonations</td>
            </tr>
        }
    </tbody>
</table>