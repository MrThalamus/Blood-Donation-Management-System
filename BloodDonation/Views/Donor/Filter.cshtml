@model List<BloodDonation.EF.Tables.Donor>

@{
    ViewBag.Title = "Filter Donors by Blood Group";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Filter Donors by Blood Group</h3>
        </div>

        <div class="card-body">

            <form method="get" class="row g-3 mb-4">

                <div class="col-md-6">

                    <label class="form-label fw-bold">
                        Select Blood Group
                    </label>

                    <select name="bloodGroup" class="form-select">

                        <option value="">-- Select Blood Group --</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>

                    </select>

                </div>

                <div class="col-md-2 d-flex align-items-end">

                    <button type="submit" class="btn btn-danger w-100">
                        Search
                    </button>

                </div>

                <div class="col-md-2 d-flex align-items-end">

                    <a href="/Donor/Filter" class="btn btn-secondary w-100">
                        Reset
                    </a>

                </div>

            </form>

            <table class="table table-bordered table-hover table-striped align-middle">

                <thead class="table-danger">

                    <tr>

                        <th>Donor ID</th>
                        <th>Full Name</th>
                        <th>Blood Group</th>
                        <th>Contact Number</th>
                        <th>City</th>
                        <th>Last Donation Date</th>
                        <th class="text-center">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Count == 0)
                    {
                        <tr>

                            <td colspan="7" class="text-center text-muted">
                                No donors found for the selected blood group.
                            </td>

                        </tr>
                    }
                    else
                    {
                        @foreach (var donor in Model)
                        {
                            <tr>

                                <td>@donor.DonorId</td>

                                <td>@donor.FullName</td>

                                <td>
                                    <span class="badge bg-danger">
                                        @donor.BloodGroup
                                    </span>
                                </td>

                                <td>@donor.ContactNo</td>

                                <td>@donor.City</td>

                                <td>
                                    @donor.LastDonationDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="text-center">

                                    <a href="/Donor/Edit/@donor.DonorId"
                                       class="btn btn-primary btn-sm">
                                        Edit
                                    </a>

                                    <a href="/Donor/Delete/@donor.DonorId"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>