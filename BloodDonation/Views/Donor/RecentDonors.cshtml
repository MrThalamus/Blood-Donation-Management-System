@model List<BloodDonation.EF.Tables.Donor>

@{
    ViewBag.Title = "Donors Sorted by Last Donation Date";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="text-danger">
            Donors Sorted by Last Donation Date
        </h2>

        <a href="/Donor/Read" class="btn btn-secondary">
            Back to Donor List
        </a>

    </div>

    <div class="card shadow">

        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">
                Most Recent Donors First
            </h4>
        </div>

        <div class="card-body">

            <table class="table table-bordered table-hover table-striped align-middle">

                <thead class="table-danger">

                    <tr>
                        <th>Donor ID</th>
                        <th>Full Name</th>
                        <th>Blood Group</th>
                        <th>Contact Number</th>
                        <th>City</th>
                        <th>Last Donation Date</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                No donors available.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var donor in Model)
                        {
                            <tr>

                                <td>@donor.DonorId</td>

                                <td>@donor.FullName</td>

                                <td>
                                    <span class="badge bg-danger">
                                        @donor.BloodGroup
                                    </span>
                                </td>

                                <td>@donor.ContactNo</td>

                                <td>@donor.City</td>

                                <td>
                                    @donor.LastDonationDate.ToString("dd MMM yyyy")
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>