@model BloodDonation.EF.Tables.Donor
@{
    ViewBag.Title = "Create Donor";
}

<h2>@ViewBag.Title</h2>

<form method="post">
   
    <label>Full Name:</label>
    <input type="text" name="FullName" value="@Model.FullName" />
    <br />
    <label>Blood Group:</label>
    <input type="text" name="BloodGroup" value="@Model.BloodGroup" />
    <br />
    <label>Contact Number:</label>
    <input type="text" name="ContactNo" value="@Model.ContactNo" />
    <br />
    <label>City:</label>
    <input type="text" name="City" value="@Model.City" />
    <br />
    <label>Last Donation Date:</label>
    <input type="date" name="LastDonationDate" value="@Model.LastDonationDate" />
    <br />
    <button type="submit">Create</button>

</form>