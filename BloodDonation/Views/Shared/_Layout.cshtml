<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Blood Bank Management System</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BloodDonation.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-danger shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" 
                asp-controller="Home" 
                asp-action="Index">BloodDonation</a>
                <button class="navbar-toggler" type="button" 
                data-bs-toggle="collapse" data-bs-target=".navbar-collapse" 
                aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav">

                        

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>
                        

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Donor"
                               asp-action="Read">
                                Donors
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Donation"
                               asp-action="Read">
                                Donations
                            </a>
                        </li>

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle text-white"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">
                                Reports
                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Donor"
                                       asp-action="Filter">
                                        Filter by Blood Group
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Donor"
                                       asp-action="RecentDonors">
                                        Recent Donors
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Donor"
                                       asp-action="DonationCount">
                                        Donation Count
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Donation"
                                       asp-action="TotalBloodCollected">
                                        Total Blood Collected
                                    </a>
                                </li>
                                

                            </ul>

                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="User"
                                   asp-action="Index">
                                    User Management
                                </a>
                            </li>
                        }

                    </ul>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <span class="navbar-text text-white mb-0">
                                Welcome, @User.Identity.Name
                            </span>
                            <a class="btn btn-outline-light btn-sm"
                               asp-controller="Account"
                               asp-action="Logout">
                                Logout
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main class="flex-grow-1">

        <div class="container py-3">
            @RenderBody()
        </div>

    </main>

    <footer class="bg-dark text-white text-center py-3 mt-5">

        <div class="container">

            <h6 class="mb-1">
                Blood Bank Management System
            </h6>

            <small>
                Developed using ASP.NET Core MVC, Entity Framework Core & Bootstrap
            </small>

            <br />

            <small>
                © @DateTime.Now.Year All Rights Reserved
            </small>

        </div>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
