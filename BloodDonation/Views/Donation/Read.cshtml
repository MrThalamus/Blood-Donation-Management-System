@model BloodDonation.Models.DonationListVM

@{
    ViewBag.Title = "Donation List";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="text-danger">
            Donation List
        </h2>

        <a href="/Donation/Create" class="btn btn-success">
            + Add New Donation
        </a>

    </div>

    <div class="card shadow">

        <div class="card-body">

            <form method="get" class="row g-3 mb-4">

                <div class="col-md-3">

                    <label class="form-label fw-bold">Donor</label>

                    <select name="donorId" class="form-select">

                        <option value="">-- All Donors --</option>

                        @foreach (var donor in Model.Donors)
                        {
                            <option value="@donor.DonorId" selected="@(Model.DonorId == donor.DonorId)">
                                @donor.FullName (#@donor.DonorId)
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-2">

                    <label class="form-label fw-bold">From Date</label>

                    <input type="date"
                           name="fromDate"
                           class="form-control"
                           value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />

                </div>

                <div class="col-md-2">

                    <label class="form-label fw-bold">To Date</label>

                    <input type="date"
                           name="toDate"
                           class="form-control"
                           value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />

                </div>

                <div class="col-md-3">

                    <label class="form-label fw-bold">Camp Name</label>

                    <input type="text"
                           name="campName"
                           class="form-control"
                           placeholder="Search by camp"
                           value="@Model.CampName" />

                </div>

                <div class="col-md-2 d-flex align-items-end gap-2">

                    <button type="submit" class="btn btn-danger w-100">
                        Search
                    </button>

                    <a href="/Donation/Read" class="btn btn-secondary w-100">
                        Reset
                    </a>

                </div>

            </form>

            <table class="table table-bordered table-hover table-striped align-middle">

                <thead class="table-danger">

                    <tr>
                        <th>Donation ID</th>
                        <th>Donor</th>
                        <th>Donation Date</th>
                        <th>Volume (mL)</th>
                        <th>Camp Name</th>
                        <th class="text-center">Action</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Donations.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                No donations found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var donation in Model.Donations)
                        {
                            <tr>

                                <td>@donation.DonationId</td>

                                <td>
                                    @donation.Donor.FullName

                                    <small class="text-muted">
                                        (#@donation.DonorId)
                                    </small>
                                </td>

                                <td>
                                    @donation.DonationDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @donation.VolumeMl mL
                                </td>

                                <td>
                                    @donation.CampName
                                </td>

                                <td class="text-center">

                                    <a href="/Donation/Edit/@donation.DonationId"
                                       class="btn btn-primary btn-sm">
                                        Edit
                                    </a>

                                    <a href="/Donation/Delete/@donation.DonationId"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

            <partial name="_Pagination" model="Model.Pager" />

        </div>

    </div>

</div>