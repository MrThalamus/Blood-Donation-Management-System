@model List<BloodDonation.EF.Tables.Donation>

@{
    ViewBag.Title = "Donation List";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="text-danger">
            Donation List
        </h2>

        <a href="/Donation/Create" class="btn btn-success">
            + Add New Donation
        </a>

    </div>

    <div class="card shadow">

        <div class="card-body">

            <table class="table table-bordered table-hover table-striped align-middle">

                <thead class="table-danger">

                    <tr>
                        <th>Donation ID</th>
                        <th>Donor ID</th>
                        <th>Donation Date</th>
                        <th>Volume (mL)</th>
                        <th>Camp Name</th>
                        <th class="text-center">Action</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                No donations found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var donation in Model)
                        {
                            <tr>

                                <td>@donation.DonationId</td>

                                <td>@donation.DonorId</td>

                                <td>
                                    @donation.DonationDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @donation.VolumeMl mL
                                </td>

                                <td>
                                    @donation.CampName
                                </td>

                                <td class="text-center">

                                    <a href="/Donation/Edit/@donation.DonationId"
                                       class="btn btn-primary btn-sm">
                                        Edit
                                    </a>

                                    <a href="/Donation/Delete/@donation.DonationId"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>