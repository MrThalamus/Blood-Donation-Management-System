@model int

@{
    ViewBag.Title = "Blood Collection Summary";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow-lg border-danger">

                <div class="card-header bg-danger text-white text-center">
                    <h3 class="mb-0">Blood Collection Summary</h3>
                </div>

                <div class="card-body text-center">

                    <h6 class="text-muted">
                        Total Blood Collected
                    </h6>

                    <h1 class="display-3 text-danger fw-bold">
                        @Model
                    </h1>

                    <h4 class="text-secondary">
                        mL
                    </h4>

                    <hr />

                    <p class="text-muted">
                        This represents the total volume of blood collected from all recorded donations.
                    </p>

                    <a href="/Donation/Read" class="btn btn-primary">
                        Back to Donation List
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>