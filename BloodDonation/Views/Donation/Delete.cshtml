@model BloodDonation.EF.Tables.Donation

@{
    ViewBag.Title = "Delete Donation";
}

<div class="container mt-5">

    <div class="card border-danger shadow">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Delete Donation</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">

                <strong>Warning!</strong>

                This action cannot be undone.

                Are you sure you want to delete this donation?

            </div>

            <table class="table table-bordered table-hover">

                <tr>
                    <th width="30%">Donation ID</th>
                    <td>@Model.DonationId</td>
                </tr>

                <tr>
                    <th>Donor ID</th>
                    <td>@Model.DonorId</td>
                </tr>

                <tr>
                    <th>Donation Date</th>
                    <td>@Model.DonationDate.ToString("yyyy-MM-dd")</td>
                </tr>

                <tr>
                    <th>Volume (mL)</th>
                    <td>@Model.VolumeMl</td>
                </tr>

                <tr>
                    <th>Camp Name</th>
                    <td>@Model.CampName</td>
                </tr>

            </table>

            <form method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.DonationId" />

                <button type="submit"
                        class="btn btn-danger">

                    Delete

                </button>

                <a href="/Donation/Read"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>