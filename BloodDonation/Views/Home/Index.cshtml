@model BloodDonation.Models.DashboardVM

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <div class="text-center mb-5">
        <h2 class="text-danger">
            Blood Bank Management Dashboard
        </h2>

        <p class="text-muted">
            @if (!string.IsNullOrWhiteSpace(Model.WelcomeName))
            {
                <text>Welcome back, @Model.WelcomeName!</text>
            }
            else
            {
                <text>Welcome to the Blood Bank Management System</text>
            }
        </p>
    </div>

    @if (Model.DonationsLast30Days == 0)
    {
        <div class="alert alert-warning">
            <strong>Low Activity:</strong> No donations have been recorded in the last 30 days.
        </div>
    }

    @if (Model.BloodGroupsWithNoDonors.Any())
    {
        <div class="alert alert-warning">
            <strong>No Donor Coverage:</strong> No registered donors for
            @string.Join(", ", Model.BloodGroupsWithNoDonors).
        </div>
    }

    <div class="row">

        <div class="col-md-3 mb-4">
            <div class="card shadow border-0 text-center">
                <div class="card-body">
                    <h5>Total Donors</h5>
                    <h2 class="text-primary">
                        @Model.TotalDonors
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow border-0 text-center">
                <div class="card-body">
                    <h5>Total Donations</h5>
                    <h2 class="text-success">
                        @Model.TotalDonations
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow border-0 text-center">
                <div class="card-body">
                    <h5>Blood Collected</h5>
                    <h2 class="text-danger">
                        @Model.TotalBloodCollected mL
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow border-0 text-center">
                <div class="card-body">
                    <h5>Blood Groups</h5>
                    <h2 class="text-warning">
                        @Model.TotalBloodGroups
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow mt-4">

        <div class="card-header bg-danger text-white">
            Quick Actions
        </div>

        <div class="card-body text-center">

            <a href="/Donor/Create" class="btn btn-success me-2">
                Register Donor
            </a>

            <a href="/Donation/Create" class="btn btn-primary me-2">
                Record Donation
            </a>

            <a href="/Donor/Read" class="btn btn-secondary me-2">
                View Donors
            </a>

            <a href="/Donation/Read" class="btn btn-dark">
                View Donations
            </a>

        </div>

    </div>

    <div class="row mt-4">

        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-danger text-white">
                    Donors by Blood Group
                </div>
                <div class="card-body">
                    <canvas id="bloodGroupChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-danger text-white">
                    Recent Donations
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentDonations.Any())
                    {
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Donor</th>
                                    <th>Blood Group</th>
                                    <th>Date</th>
                                    <th>Volume</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var donation in Model.RecentDonations)
                                {
                                    <tr>
                                        <td>@donation.Donor.FullName</td>
                                        <td>@donation.Donor.BloodGroup.Trim()</td>
                                        <td>@donation.DonationDate.ToString("MMM dd, yyyy")</td>
                                        <td>@donation.VolumeMl mL</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted text-center p-3 mb-0">No donations recorded yet.</p>
                    }
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script>
        const bloodGroupCtx = document.getElementById('bloodGroupChart');
        new Chart(bloodGroupCtx, {
            type: 'bar',
            data: {
                labels: @Json.Serialize(Model.BloodGroupBreakdown.Select(g => g.BloodGroup)),
                datasets: [{
                    label: 'Donors',
                    data: @Json.Serialize(Model.BloodGroupBreakdown.Select(g => g.DonorCount)),
                    backgroundColor: '#dc3545'
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    </script>
}